# Django
SECRET_KEY=your-django-secret-key-here
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1

# PostgreSQL Database
DB_ENGINE=django.db.backends.postgresql
DB_NAME=event_scheduler_db
DB_USER=postgres
DB_PASSWORD=your_password_here
DB_HOST=localhost
DB_PORT=5432

# CORS
CORS_ALLOW_ALL_ORIGINS=True

# Microsoft 365 / Entra ID SSO Configuration
MICROSOFT_CLIENT_ID=your_azure_client_id_here
MICROSOFT_TENANT_ID=common
# Comma-separated list of allowed domains (leave empty to allow any domain, or specify your corporate domain)
MICROSOFT_ALLOWED_DOMAINS=innovyx.com
# Set to True to enforce that only users pre-registered in the database by admin can log in
MICROSOFT_REQUIRE_REGISTERED_USER=True
# Email displayed on the "Contact Admin" page for unregistered users
ADMIN_CONTACT_EMAIL=admin@innovyx.com
